---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/sections/Hero.astro';
import ServicesPreview from '../components/sections/ServicesPreview.astro';
import Reel from '../components/sections/Reel.astro';
import Process from '../components/sections/Process.astro';
import FinalCta from '../components/sections/FinalCta.astro';

// Videos — imported so Vite fingerprints and serves them; source files live in /assets and are gitignored.
import shortFormCard from '@/assets/reels/reel-01.mp4';
import longFormCard from '@/assets/long-form/long-01.mp4';
import facelessCard from '@/assets/long-form/talking-head-01.mp4';
import showReel from '@/assets/long-form/show-reel.mp4';

const services = [
  { slug: '/short-form', label: 'Short-form', mono: '01 · VERTICAL 9:16', desc: 'TikTok, Reels, Shorts. Hook-driven cuts that earn the scroll-stop.', tags: ['Hook', 'Pace', 'Captions'], video: shortFormCard },
  { slug: '/long-form', label: 'Long-form', mono: '02 · WIDESCREEN 16:9', desc: 'YouTube long-form, brand films, documentaries, podcasts. Story, color, and sound that respect the runtime.', tags: ['Story', 'Color', 'Sound'], video: longFormCard },
  { slug: '/faceless', label: 'Faceless', mono: '03 · FACELESS YOUTUBE', desc: 'High-volume faceless content actually edited — B-roll, motion, kinetic type — built to read as premium.', tags: ['B-roll', 'Motion', 'Type'], video: facelessCard },
];

const process = [
  { num: '01', title: 'Brief', copy: 'Tight intake call. We pin the audience, the format, the tone, and the deliverables before a single clip lands on the timeline.' },
  { num: '02', title: 'Edit', copy: 'First assembly within days. We send a private review link with frame-accurate comment threading. You stay in the loop.' },
  { num: '03', title: 'Refine', copy: 'Two rounds of revisions included. Color, sound, captions, masters. We deliver in whatever spec your destination needs.' },
];
---
<BaseLayout intro={true} title="Lumero Media — Post-production studio">
  <Hero />
  <Reel
    id="work"
    heading="Lumero Reel — 2026"
    meta="Runtime · 02:14"
    src={showReel}
  />
  <ServicesPreview services={services} />
  <Process
    label="How we work"
    headline="Three steps,<br/>no theatre."
    items={process}
  />
  <FinalCta heading="Ready when you are." />
</BaseLayout>
