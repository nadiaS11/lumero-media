---
import BaseLayout from '../../layouts/BaseLayout.astro';
import VideoPlayer from '../../components/VideoPlayer.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const works = (await getCollection('work')).sort((a, b) => a.data.order - b.data.order);
  return works.map((entry, i) => ({
    params: { slug: entry.id },
    props: { entry, next: works[(i + 1) % works.length] },
  }));
}

const { entry, next } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;
---
<BaseLayout title={`${d.title} — Lumero Media`} description={`${d.title} for ${d.client} — ${d.serviceLabel}, ${d.year}.`}>
  <article>
    <!-- Hero -->
    <section class="relative w-full">
      <div class="relative w-full aspect-video md:aspect-[2.39/1] overflow-hidden bg-black" transition:name={`work-${entry.id}`}>
        {d.reel ? (
          <video src={d.reel} poster={d.poster} autoplay muted loop playsinline class="absolute inset-0 w-full h-full object-cover" />
        ) : (
          <img src={d.poster} alt={d.title} class="absolute inset-0 w-full h-full object-cover" />
        )}
        <div class="absolute inset-0 bg-gradient-to-t from-bg to-transparent"></div>
      </div>
    </section>

    <!-- Title block -->
    <section class="container-l py-16 md:py-24 grid md:grid-cols-12 gap-8">
      <div class="md:col-span-8">
        <p class="mono mb-6">{d.serviceLabel} · {d.year}</p>
        <h1 class="display-h1">{d.title}</h1>
        <p class="mono mt-4 text-fg-muted">{d.client}</p>
      </div>
      <aside class="md:col-span-4 md:pt-2 space-y-6">
        <div>
          <p class="mono mb-2">Role</p>
          <ul class="text-sm space-y-1">
            {d.role.map((r) => <li>{r}</li>)}
          </ul>
        </div>
        {d.runtime && (
          <div>
            <p class="mono mb-2">Runtime</p>
            <p class="text-sm">{d.runtime}</p>
          </div>
        )}
        <div>
          <p class="mono mb-2">Format</p>
          <p class="text-sm">{d.aspect}</p>
        </div>
      </aside>
    </section>

    <!-- Body -->
    <section class="container-l pb-16 md:pb-24 grid md:grid-cols-12 gap-8">
      <div class="md:col-span-8 md:col-start-3 prose-content text-fg-muted body-lg space-y-6">
        <Content />
      </div>
    </section>

    <!-- Player -->
    {d.reel && (
      <section class="container-l pb-16 md:pb-24">
        <VideoPlayer src={d.reel} poster={d.poster} caption={`${d.title} · Full cut`} />
      </section>
    )}

    {d.outcome && (
      <section class="container-l pb-24">
        <div class="border-t border-border pt-10">
          <p class="mono mb-3">Outcome</p>
          <p class="display-h2 max-w-3xl">{d.outcome}</p>
        </div>
      </section>
    )}

    <!-- Next -->
    <section class="container-l pb-32">
      <a href={`/work/${next.id}`} class="block group border-t border-border pt-10">
        <p class="mono mb-3">Next project →</p>
        <h2 class="display-h1 group-hover:text-accent transition-colors">{next.data.title}</h2>
        <p class="mono mt-3">{next.data.client} · {next.data.serviceLabel}</p>
      </a>
    </section>
  </article>

  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'CreativeWork',
    name: d.title,
    creator: { '@type': 'Organization', name: 'Lumero Media' },
    dateCreated: String(d.year),
    about: d.client,
    genre: d.serviceLabel,
  })} />
</BaseLayout>

<style>
  .prose-content :global(p) { margin-bottom: 1.25rem; }
  .prose-content :global(h2) { font-family: var(--font-display); font-size: clamp(1.5rem, 2.5vw, 2rem); color: var(--text-primary); margin-top: 2.5rem; margin-bottom: 1rem; }
</style>
