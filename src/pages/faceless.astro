---
import ServiceLayout from '../layouts/ServiceLayout.astro';

const body = [
  'Faceless YouTube has a reputation problem, and most of it is deserved. The niche is flooded with template-spun videos that read as content-mill output the moment they start playing. We do not make those.',
  'Our faceless work is actually edited. We sound-design every transition, source B-roll that fits the script instead of vaguely accompanying it, and use motion graphics and kinetic typography as punctuation — not decoration. Every video reads as something a person made.',
  'We work with channel operators across history, philosophy, top-10s, motivation, lifestyle, and commentary niches. Batch turnarounds available for networks.',
];

const process = [
  { num: '01', title: 'Script', copy: 'We script-read for pacing and act structure before sourcing a single asset. Voiceover gets timed against the act breaks.' },
  { num: '02', title: 'Voice', copy: 'You provide the VO or use one of our trusted partners. We clean, EQ, and de-breathe before timeline work begins.' },
  { num: '03', title: 'B-roll', copy: 'Hand-selected stock from licensed libraries plus AI gen where it earns its place. Never generic, always tied to the line.' },
  { num: '04', title: 'Motion', copy: 'Kinetic type for emphasis, lower-thirds for sourcing, transitions that punctuate the script. Restrained, on purpose.' },
  { num: '05', title: 'Master', copy: 'Mixed to YouTube’s loudness target, exported at the right bitrate, delivered with a thumbnail concept and metadata draft on request.' },
];

const deliverables = [
  'Edited master in 16:9 1080p or 4K H.264 — YouTube-spec',
  'Thumbnail concept (optional add-on, 2 variants)',
  'Title and description metadata copy assistance (optional add-on)',
  'SRT captions for accessibility',
  'Batch turnaround: 4–8 videos per week for network operators on retainer; 7–10 days for single-video clients',
];

const faqs = [
  { q: 'Do you write scripts?', a: 'We don’t write from scratch, but we provide structural edits and pacing notes on every script before we cut. Some clients use those notes; some don’t.' },
  { q: 'Do you provide voiceover?', a: 'We don’t voice in-house, but we work with a handful of trusted VO partners across English accents and can route the request for you.' },
  { q: 'Will my videos look like everyone else’s in the niche?', a: 'No. We deliberately work against the template aesthetic. Your channel gets a consistent visual language, but it’s built for the channel — not pulled from a preset pack.' },
  { q: 'Can you handle a network of channels?', a: 'Yes. Batch retainers run 4–12 videos per week across multiple channels, with shared style guides per channel and per-niche editors assigned.' },
  { q: 'Is the B-roll AI-generated?', a: 'Mostly licensed stock (Artgrid, Storyblocks, archival) with AI gen used selectively where it actually fits — historical reconstruction, abstract concepts. We disclose AI use on request.' },
  { q: 'What rights do I have to the edit?', a: 'Full commercial rights to the finished video, sublicensed stock cleared for monetization. Editing project files are available on the top retainer tier.' },
  { q: 'Can you optimize for retention?', a: 'We track retention curves on shipped work and adjust pacing in the next batch. Cold A/B testing of hooks is part of the network-tier retainer.' },
];
---
<ServiceLayout
  service="faceless"
  title="Faceless — Lumero Media"
  description="Premium faceless YouTube video editing — actually edited, with B-roll, motion graphics, and sound design that reads as crafted."
  caption="03 · Faceless YouTube · History / Philosophy / Top-10 / Motivation"
  headline="Faceless content, fully crafted."
  subline="Not template-spun — actually edited, with B-roll, sound design, and motion graphics that read as premium."
  body={body}
  process={process}
  deliverables={deliverables}
  faqs={faqs}
  ctaLabel="Start a faceless project →"
>
  <div slot="hero-asset">
    <div class="grid md:grid-cols-2 gap-6">
      <div class="relative aspect-video overflow-hidden rounded-[2px] bg-surface border border-border">
        <img src="/posters/faceless-thumb.jpg" alt="Faceless YouTube thumbnail sample" class="absolute inset-0 w-full h-full object-cover" />
        <div class="absolute inset-x-0 bottom-0 p-4 bg-gradient-to-t from-black/70 to-transparent">
          <p class="mono">Thumbnail · 16:9</p>
        </div>
      </div>
      <div class="relative aspect-video overflow-hidden rounded-[2px] bg-bg-elevated border border-border p-6">
        <p class="mono mb-4 text-accent">Timeline · v04</p>
        <div class="space-y-2 font-mono text-xs">
          <div class="flex gap-2 items-center"><span class="w-12 opacity-60">V3</span><div class="h-3 bg-accent/40 rounded-sm flex-1"></div></div>
          <div class="flex gap-2 items-center"><span class="w-12 opacity-60">V2</span><div class="h-3 bg-white/20 rounded-sm flex-1"></div></div>
          <div class="flex gap-2 items-center"><span class="w-12 opacity-60">V1</span><div class="h-3 bg-white/40 rounded-sm w-2/3"></div></div>
          <div class="flex gap-2 items-center"><span class="w-12 opacity-60">A1</span><div class="h-3 bg-white/15 rounded-sm flex-1"></div></div>
          <div class="flex gap-2 items-center"><span class="w-12 opacity-60">A2</span><div class="h-3 bg-white/15 rounded-sm w-5/6"></div></div>
        </div>
        <p class="mono mt-6 opacity-60">12:14 · 1080p · 23.976</p>
      </div>
    </div>
  </div>
</ServiceLayout>
