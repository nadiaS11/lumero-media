---
import ServiceLayout from '../layouts/ServiceLayout.astro';
import reel01 from '@/assets/reels/reel-01.mp4';
import reel02 from '@/assets/reels/reel-02.mp4';
import reel03 from '@/assets/reels/reel-03.mp4';
import reel04 from '@/assets/reels/reel-04.mp4';
import reel05 from '@/assets/reels/reel-05.mp4';
import reel06 from '@/assets/reels/reel-06.mp4';
import reel07 from '@/assets/reels/reel-07.mp4';
import reel08 from '@/assets/reels/reel-08.mp4';

const reels = [reel01, reel02, reel03, reel04, reel05, reel06, reel07, reel08];

const body = [
  'Three seconds to earn the next thirty. Hook-first cuts, tight captions, mixed for phone speakers and headphones at once.',
  'Platform-native masters for TikTok, Reels, and Shorts — no letterboxed landscape edits.',
];

const process = [
  { num: '01', title: 'Hook', copy: 'We screen all your footage and pull the strongest first three seconds. The hook drives the rest of the cut, not the other way around.' },
  { num: '02', title: 'Pace', copy: 'Cut to the beat of the speaker, then break the beat to keep the eye honest. We never coast — every second has a job.' },
  { num: '03', title: 'Caption', copy: 'Burned-in captions in a brand-consistent style, plus a clean SRT for accessibility and edits. Punctuation that reads at speed.' },
  { num: '04', title: 'Deliver', copy: 'Platform-ready masters for TikTok, Reels, and Shorts with the right aspect, framerate, and bitrate. Sound mixed for phones.' },
];

const deliverables = [
  'Vertical 9:16 master in client-specified codec (typically H.264, 60fps where source allows)',
  'Burned-in captions plus a clean SRT sidecar file',
  'Platform-ready cuts trimmed to each platform’s ideal duration (TikTok / Reels / Shorts)',
  'Thumbnail concept (optional, +1 round of revisions)',
  'Typical first-cut turnaround: 3–5 business days for a single deliverable; same-week for retainer clients',
];

const faqs = [
  { q: 'Do you work from raw footage or finished cuts?', a: 'Both. We are most useful when given raw footage and a brief — that’s where the editing decisions actually matter — but we will polish a rough cut if that’s what the project needs.' },
  { q: 'How many hooks do you test?', a: 'For a single deliverable, we send one cut with one hook. For paid-ad work or retainer clients, we typically produce 3–5 hook variants from the same edit for A/B testing.' },
  { q: 'Can you handle captioning in multiple languages?', a: 'Yes. We deliver burned-in captions in the primary language and provide SRTs in any additional languages you specify, sourced via human translation, not auto-translate.' },
  { q: 'Do you provide stock music or do we?', a: 'Either. We have Epidemic Sound and Artlist licenses for client projects. If you have a brand sonic library or a sync deal, we work from that.' },
  { q: 'What’s the minimum engagement?', a: 'One-offs are welcome. Most short-form clients move to a 4-per-month retainer after the first month because the per-cut cost drops meaningfully.' },
  { q: 'Do you cut for paid ads?', a: 'Yes — we treat ad cuts differently from organic. Ad creative gets multiple hook variants, multiple CTA placements, and we keep the iteration cycle to under 48 hours.' },
  { q: 'Do you offer thumbnails?', a: 'For Shorts and Reels, yes. We treat thumbnails as part of the hook system, not a decorative add-on.' },
];
---
<ServiceLayout
  service="short-form"
  title="Short-form — Lumero Media"
  description="Vertical 9:16 short-form video editing for creators and brands. Hook-first cuts for TikTok, Reels, and Shorts."
  caption="01 · Vertical 9:16 · TikTok / Reels / Shorts"
  headline="Short-form that earns the scroll-stop."
  subline="Hook-driven editing for creators and brands who treat the first three seconds as the whole game."
  body={body}
  process={process}
  deliverables={deliverables}
  faqs={faqs}
  ctaLabel="Start a short-form project →"
>
  <div slot="hero-asset">
    <div class="flex items-center justify-between mb-6">
      <p class="mono">Selected work · {reels.length} reels</p>
      <p class="mono opacity-60">9:16 · loop</p>
    </div>
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 md:gap-6">
      {reels.map((src) => (
        <div class="relative w-full aspect-[9/16] rounded-[2px] border border-border bg-black overflow-hidden">
          <video
            src={src}
            playsinline controls preload="metadata"
            controlslist="nodownload"
            class="absolute inset-0 w-full h-full object-cover"
          ></video>
        </div>
      ))}
    </div>
  </div>
</ServiceLayout>
