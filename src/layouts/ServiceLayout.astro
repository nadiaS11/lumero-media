---
import BaseLayout from './BaseLayout.astro';
import ServicePageHero from '../components/sections/ServicePageHero.astro';
import HeroAsset from '../components/sections/HeroAsset.astro';
import IntroBody from '../components/sections/IntroBody.astro';
import Process from '../components/sections/Process.astro';
import Deliverables from '../components/sections/Deliverables.astro';
import FaqSection from '../components/sections/FaqSection.astro';
import FinalCta from '../components/sections/FinalCta.astro';

interface Props {
  service: 'short-form' | 'long-form' | 'faceless';
  caption: string;
  headline: string;
  subline?: string;
  body: string[];
  process: { num: string; title: string; copy: string }[];
  deliverables: string[];
  faqs: { q: string; a: string }[];
  ctaLabel: string;
  title: string;
  description: string;
}

const {
  caption, headline, subline, body, process, deliverables, faqs, ctaLabel, title, description,
} = Astro.props;
---
<BaseLayout title={title} description={description}>
  <ServicePageHero caption={caption} headline={headline} subline={subline} />
  <HeroAsset>
    <slot name="hero-asset" />
  </HeroAsset>
  <IntroBody paragraphs={body} />
  <Process items={process} variant="wide" />
  <Deliverables items={deliverables} />
  <FaqSection items={faqs} />
  <FinalCta variant="row" heading={ctaLabel} />
</BaseLayout>
