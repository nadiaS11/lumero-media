---
interface Props { items: { q: string; a: string }[] }
const { items } = Astro.props;
---
<div x-data="{ open: null }" class="border-t border-[var(--border)]">
  {items.map((item, i) => (
    <div class="border-b border-[var(--border)]">
      <button
        @click={`open = open === ${i} ? null : ${i}`}
        :aria-expanded={`open === ${i}`}
        aria-controls={`faq-${i}`}
        class="w-full text-left py-6 flex items-baseline justify-between gap-6 group"
      >
        <span class="font-display text-xl md:text-2xl pr-4">{item.q}</span>
        <span class="mono shrink-0" :class={`open === ${i} ? 'text-[var(--accent)]' : ''`}>
          <span x-text={`open === ${i} ? '—' : '+'`}>+</span>
        </span>
      </button>
      <div id={`faq-${i}`} x-show={`open === ${i}`} x-collapse x-cloak>
        <p class="pb-6 pr-8 text-[var(--text-secondary)] leading-relaxed max-w-2xl">{item.a}</p>
      </div>
    </div>
  ))}
</div>
