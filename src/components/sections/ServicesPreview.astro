---
interface Service {
  slug: string;
  label: string;
  mono: string;
  desc: string;
  tags: string[];
}
interface Props {
  label?: string;
  caption?: string;
  services: Service[];
}
const { label = 'What we do', caption = 'Three services', services } = Astro.props;

const slugify = (s: string) => s.toLowerCase().replace(/\s+/g, '-');
---
<section class="container-l py-32 md:py-40">
  <div class="flex items-baseline justify-between mb-16">
    <p class="mono">{label}</p>
    <p class="mono opacity-60">{caption}</p>
  </div>
  <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
    {services.map((s) => (
      <a
        href={s.slug}
        x-data="{ hovering: false }"
        x-on:mouseenter="hovering = true"
        x-on:mouseleave="hovering = false"
        class="group relative block min-h-[60vh] lg:min-h-[80vh] rounded-xs border border-border overflow-hidden bg-bg-elevated"
      >
        <video
          x-ref="v"
          x-effect="hovering ? $refs.v?.play() : $refs.v?.pause()"
          muted loop playsinline preload="none"
          class="absolute inset-0 w-full h-full object-cover opacity-40 transition-opacity duration-500"
          x-bind:class="hovering ? 'opacity-70' : 'opacity-40'"
          poster={`/posters/${slugify(s.label)}.jpg`}
        >
          <source src={`/reels/${slugify(s.label)}.mp4`} type="video/mp4" />
        </video>
        <div class="absolute inset-0 bg-linear-to-t from-black/70 via-black/30 to-transparent"></div>
        <div class="relative h-full flex flex-col justify-between p-6 md:p-10">
          <p class="mono">{s.mono}</p>
          <div>
            <h3 class="display-h1 mb-4">{s.label}</h3>
            <p class="body-lg max-w-md mb-8">{s.desc}</p>
            <div class="flex items-center justify-between">
              <div class="flex gap-2">
                {s.tags.map((t) => <span class="btn-pill">{t}</span>)}
              </div>
              <span class="mono group-hover:text-accent transition">View service →</span>
            </div>
          </div>
        </div>
      </a>
    ))}
  </div>
</section>
