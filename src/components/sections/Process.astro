---
interface Props {
  label?: string;
  headline?: string;
  items: { num: string; title: string; copy: string }[];
  /** "grid" = 3-up columns (home), "wide" = 4-up columns (service pages) */
  variant?: 'grid' | 'wide';
}
const { label = 'Process', headline, items, variant = 'grid' } = Astro.props;
const cols = variant === 'wide'
  ? 'md:grid-cols-2 lg:grid-cols-4'
  : 'md:grid-cols-3';
---
<section class="container-l py-32 md:py-40">
  {headline ? (
    <div class="grid md:grid-cols-12 gap-8 mb-16">
      <div class="md:col-span-4">
        <p class="mono mb-4">{label}</p>
        <h2 class="display-h1" set:html={headline}></h2>
      </div>
    </div>
  ) : (
    <p class="mono mb-12">{label}</p>
  )}
  <div class={`grid ${cols} gap-x-8 gap-y-12`}>
    {items.map((s) => (
      <div class={variant === 'grid' ? 'border-t border-border pt-8' : ''}>
        <p class={`mono text-accent ${variant === 'grid' ? 'mb-6' : 'mb-4'}`}>{s.num}</p>
        <h3 class={`${variant === 'grid' ? 'display-h2 mb-4' : 'display-h2 mb-3'}`}>{s.title}</h3>
        <p class="text-fg-muted leading-relaxed">{s.copy}</p>
      </div>
    ))}
  </div>
</section>
