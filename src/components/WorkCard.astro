---
import type { CollectionEntry } from 'astro:content';
interface Props {
  work: CollectionEntry<'work'>;
  span?: 'sm' | 'md' | 'lg' | 'wide' | 'tall';
}
const { work, span = 'md' } = Astro.props;
const d = work.data;
const aspectClass = d.aspect === '9:16' ? 'aspect-[9/16]'
  : d.aspect === '2.39:1' ? 'aspect-[2.39/1]'
  : d.aspect === '4:5' ? 'aspect-[4/5]'
  : 'aspect-video';
const spanClass = {
  sm: 'md:col-span-3',
  md: 'md:col-span-4',
  lg: 'md:col-span-6',
  wide: 'md:col-span-8',
  tall: 'md:col-span-4 md:row-span-2',
}[span];
---
<article
  x-data="{ hovering: false }"
  @mouseenter="hovering = true"
  @mouseleave="hovering = false"
  x-effect="
    const v = $refs.preview;
    if (!v) return;
    if (hovering) { v.play().catch(()=>{}); } else { v.pause(); v.currentTime = 0; }
  "
  class:list={["group relative overflow-hidden rounded-[2px] bg-[var(--surface)] border border-[var(--border)]", spanClass]}
>
  <a href={`/work/${work.id}`} class="block" transition:name={`work-${work.id}`}>
    <div class:list={["relative overflow-hidden", aspectClass]}>
      <img
        src={d.poster}
        alt={`${d.title} — ${d.client}`}
        loading="lazy"
        decoding="async"
        class="absolute inset-0 w-full h-full object-cover transition-transform duration-700"
        :class="hovering ? 'scale-[1.03]' : 'scale-100'"
      />
      {d.reel && (
        <video
          x-ref="preview"
          src={d.reel}
          muted
          playsinline
          loop
          preload="none"
          class="absolute inset-0 w-full h-full object-cover transition-opacity duration-300"
          :class="hovering ? 'opacity-100' : 'opacity-0'"
        ></video>
      )}
      <!-- progress bar -->
      <div class="absolute left-0 right-0 bottom-0 h-px bg-[var(--accent)] origin-left transition-transform duration-[1200ms]"
           :class="hovering ? 'scale-x-100' : 'scale-x-0'"></div>
      <!-- metadata reveal -->
      <div
        class="absolute inset-x-0 bottom-0 p-5 bg-gradient-to-t from-black/80 to-transparent transition-opacity duration-300"
        :class="hovering ? 'opacity-100' : 'opacity-0'"
      >
        <p class="mono text-[var(--text-primary)]/80">{d.client} · {d.year} · {d.serviceLabel}{d.runtime ? ' · ' + d.runtime : ''}</p>
      </div>
    </div>
    <div class="p-5 flex items-baseline justify-between">
      <div>
        <h3 class="font-display text-lg md:text-xl">{d.title}</h3>
        <p class="mono mt-1">{d.client} · {d.year}</p>
      </div>
      <span class="mono opacity-70 group-hover:opacity-100 group-hover:text-[var(--accent)] transition">→</span>
    </div>
  </a>
</article>
